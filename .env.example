# Bright Data — get an API key from your account, or run `brightdata login`
BRIGHTDATA_API_KEY=

# Telegram alerts (optional — pipeline degrades gracefully without them)
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 0 to keep a human approval gate on heals (`brightdata scraper approve`)
RADAR_AUTO_APPROVE=1

# Optional: if set, POST /api/run requires this value in the X-Run-Token
# header. Set it on any public deployment so strangers can't burn your
# scraping credits; leave empty for local demos (the button just works).
RADAR_RUN_TOKEN=
